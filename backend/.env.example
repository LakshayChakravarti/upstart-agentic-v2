# ── AI Providers ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key

# ── Auth ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Default (local development): backend/data/upstart.db
# Free Render Demo (ephemeral filesystem): ./data/upstart.db
#
# ⚠️ CAUTION — EPHEMERAL STORAGE WARNING:
# In cloud environments without persistent disks (such as Render's Free tier),
# the filesystem is EPHEMERAL. The SQLite database will be wiped whenever the
# service spins down due to inactivity, restarts, or is redeployed.
# This setup is strictly intended for disposable testing and demonstration.
DATABASE_PATH=

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Feature Flags ────────────────────────────────────────────────
# Set to "true" to enable the four-persona Council + Chairman synthesis
USE_COUNCIL=true
